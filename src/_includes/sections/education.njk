<h2 class="band-title" id="education">Education</h2>
{%- for item in education %}
<div class="xp xp-edu">
  <div class="when-col">
    <span class="when">{{ item.when }}</span>
    {%- if item.logo %}
    <img class="org-logo" src="{{ item.logo }}" alt="" width="84" height="84" loading="lazy">
    {%- endif %}
  </div>
  <div>
    <div class="where">{{ item.where }}</div>
    <div class="what">{{ item.role }}</div>
    <p>{{ item.summary }}</p>
  </div>
</div>
{%- endfor %}
