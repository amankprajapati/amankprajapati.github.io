<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Contact icons: Font Awesome Free 6.7.2, https://fontawesome.com, CC BY 4.0 -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site.title }}</title>
  <meta name="description" content="{{ site.description }}">
  <!-- Fonts are self-hosted and preloaded so text renders in its final font instead of swapping in late -->
  <link rel="preload" href="assets/fonts/source-serif-4-latin-7.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="assets/fonts/ibm-plex-sans-latin-5.woff2" as="font" type="font/woff2" crossorigin>
  {%- for sheet in ["fonts", "base", "layout", "masthead", "entry", "experience", "video", "figures", "animations", "responsive"] %}
  <link rel="stylesheet" href="assets/css/{{ sheet }}.css">
  {%- endfor %}
  <script type="module" src="assets/js/main.js"></script>
</head>
<body>
{% include "partials/svg-defs.svg" %}
{{ content | safe }}
</body>
</html>
